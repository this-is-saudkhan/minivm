        {
            "l": {"columns": [{"name": "k", "type": "INT"}, {"name": "v", "type": "STR"}]},
            "r": {"columns": [{"name": "k", "type": "INT"}, {"name": "w", "type": "STR"}]},
        },
        """
        LOAD lk, l.k
        LOAD rk, r.k
        NLJOIN li, ri, lk, rk, NULLEQ
        LOAD lv, l.v
        LOAD rw, r.w
        GATHER a, lv, li
        GATHER b, rw, ri
        OUT a, b
        """,
    ),
    (
        {
            "d": {"columns": [{"name": "x", "type": "DATE"}, {"name": "g", "type": "STR"}]},
        },
        """
        LOAD x, d.x
        LOAD g, d.g
        GROUP grp, g
        GMIN mn, grp, x
        GMAX mx, grp, x
        DATEDIFF diff, mx, mn
        DATEADD plus, mx, 10
        GFIRST f, grp
        GATHER key, g, f
        OUT key, mn, mx, diff, plus
        """,
    ),
]


def main():
    if len(sys.argv) != 2:
        print("usage: evaluate OPTIMIZER", file=sys.stderr)
        sys.exit(2)
    optimizer = sys.argv[1]
    start = time.monotonic()
    deadline = start + TIME_BUDGET_SECONDS

    defects = []

    with open(os.path.join(HERE, "examples", "schema.json"), encoding="utf-8") as f:
        bundled_schema = json.load(f)
    bundled_schema_path = os.path.join(HERE, "examples", "schema.json")
    bundled_programs = sorted(glob.glob(os.path.join(HERE, "examples", "programs", "*.mini")))
    bundled_data = os.path.join(HERE, "examples", "data.json")

    scratch = tempfile.mkdtemp(prefix="minivm_eval_")
    rng = random.Random(0)

    try:
        # Layer 1: regression against the bundled example data, exactly.
        for prog in bundled_programs:
            if time.monotonic() > deadline:
                break
            try:
                evaluate_program(
                    optimizer, prog, bundled_schema_path, bundled_schema,
                    deadline, os.path.basename(prog), [bundled_data],
                )
            except Defect as d:
                defects.append(str(d))

        # Layer 2: fuzz random data against the bundled schema + programs.
        # Each program gets its own batch of datasets, biased toward the
        # literal constants that program's own comparisons use (see
        # harvest_literals) -- that's where an off-by-one or flipped-sense
        # rewrite of a filter is likeliest to surface.
        ds_counter = [0]

        def fresh_datasets(schema_for_gen, text_for_literals, n, max_rows):
            pool = harvest_literals(text_for_literals)
            out = []
            for _ in range(n):
                if time.monotonic() > deadline:
                    break
                ts = generate_tableset(schema_for_gen, rng, max_rows, pool)
                ds_counter[0] += 1
                out.append(make_dataset_file(ts, scratch, ds_counter[0]))
            return out

        for prog in bundled_programs:
            if time.monotonic() > deadline:
                break
            with open(prog, encoding="utf-8") as f:
                prog_text = f.read()
            fuzz_datasets = fresh_datasets(bundled_schema, prog_text, 50, 30)
            try:
                evaluate_program(
                    optimizer, prog, bundled_schema_path, bundled_schema,
                    deadline, os.path.basename(prog) + " [fuzz]", fuzz_datasets,
                )
            except Defect as d:
                defects.append(str(d))

        # Layer 3: small synthetic programs covering opcodes the bundled
        # examples don't exercise (DIV/IDIV/MOD, TOPK, NLJOIN+NULLEQ, dates).
        for idx, (syn_schema, syn_prog_text) in enumerate(SYNTHETIC):
            if time.monotonic() > deadline:
                break
            prog_path = os.path.join(scratch, "syn_%d.mini" % idx)
            with open(prog_path, "w", encoding="utf-8") as f:
                f.write(syn_prog_text)
            schema_path = os.path.join(scratch, "syn_%d.schema.json" % idx)
            with open(schema_path, "w", encoding="utf-8") as f:
                json.dump(syn_schema, f)
            syn_datasets = fresh_datasets(syn_schema, syn_prog_text, 20, 20)
            try:
                evaluate_program(
                    optimizer, prog_path, schema_path, syn_schema,
                    deadline, "synthetic#%d" % idx, syn_datasets,
                )
            except Defect as d:
                defects.append(str(d))
    finally:
        pass  # leave scratch dir for inspection; OS temp cleanup handles it

    if defects:
        print("FOUND %d defect(s):" % len(defects), file=sys.stderr)
        for d in defects[:20]:
            print(" -", d, file=sys.stderr)
        sys.exit(1)
    print("no defects found (%.1fs elapsed)" % (time.monotonic() - start), file=sys.stderr)
    sys.exit(0)


if __name__ == "__main__":
    main()
